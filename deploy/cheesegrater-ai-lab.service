[Unit]
Description=Cheesegrater AI Lab web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/cheesegrater-ai-lab/web
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=LAB_UI_PORT=8081
Environment=LAB_CONFIG=/etc/cheesegrater-ai-lab/config.json
Environment=LAB_WEB_DIR=/opt/cheesegrater-ai-lab/web
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=WRANGLER_LOG_PATH=/tmp/cheesegrater-ai-lab-wrangler.log
Environment=WRANGLER_WRITE_LOGS=false
ExecStart=/usr/local/bin/node /opt/cheesegrater-ai-lab/server/lab-server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
