# Optional browser-facing API endpoint. Empty means same origin.
LAB_API_URL=

# Deployment settings may override these without changing tracked files.
CHEESEGRATER_AI_LAB_INSTALL_DIR=/opt/cheesegrater-ai-lab
CHEESEGRATER_AI_LAB_PORT=8080

# Optional provider credential. Set only in an ignored .env file.
HF_TOKEN=
